-- =====================================================================
-- CONFERÊNCIA (apenas leitura, não altera nenhum dado)
-- =====================================================================

-- Quantidade de registros por tabela
-- Esperado: 20 filmes, 20 salas, 336 sessões,
--           22235 ingressos, 7454 vendas de bomboniere
SELECT 'Dim_Filme' AS tabela, COUNT(*) AS registros FROM Dim_Filme
UNION ALL SELECT 'Dim_Sala', COUNT(*) FROM Dim_Sala
UNION ALL SELECT 'Fato_Sessao', COUNT(*) FROM Fato_Sessao
UNION ALL SELECT 'Fato_Venda_Ingresso', COUNT(*) FROM Fato_Venda_Ingresso
UNION ALL SELECT 'Fato_Venda_Bomboniere', COUNT(*) FROM Fato_Venda_Bomboniere;

-- Resumo por tipo de sala: sessões, lugares ofertados e ingressos vendidos.
-- Os ingressos são contados em uma subconsulta para não duplicar linhas.
SELECT
    sa.Tipo_Sala,
    COUNT(*)                         AS sessoes,
    SUM(sa.Capacidade)               AS lugares_ofertados,
    SUM(COALESCE(i.ingressos, 0))    AS ingressos_vendidos
FROM Fato_Sessao s
JOIN Dim_Sala sa ON sa.ID_Sala = s.ID_Sala
LEFT JOIN (
    SELECT ID_Sessao, COUNT(*) AS ingressos
    FROM Fato_Venda_Ingresso
    GROUP BY ID_Sessao
) i ON i.ID_Sessao = s.ID_Sessao
GROUP BY sa.Tipo_Sala
ORDER BY sa.Tipo_Sala;
