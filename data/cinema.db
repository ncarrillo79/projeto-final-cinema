-- =====================================================================
-- PROJETO FINAL - ANÁLISE DE DADOS (Toti Diversidade) - Tema: CINEMA
-- Modelo dimensional com dados SIMULADOS (não são dados reais).
-- Arquivo gerado por gerar_dados_cinema.py - não editar à mão.
-- Semente: 42 | Período das sessões: 2023-11-16 a 2023-12-13
-- Volume: 336 sessões, 22235 ingressos, 7454 vendas de bomboniere
-- =====================================================================

DROP TABLE IF EXISTS Fato_Venda_Bomboniere;
DROP TABLE IF EXISTS Fato_Venda_Ingresso;
DROP TABLE IF EXISTS Fato_Sessao;
DROP TABLE IF EXISTS Dim_Sala;
DROP TABLE IF EXISTS Dim_Filme;

CREATE TABLE Dim_Filme (
    ID_Filme INT PRIMARY KEY,
    Titulo VARCHAR(100),
    Genero VARCHAR(50),
    Classificacao_Indicativa VARCHAR(10),
    Data_Lancamento DATE
);

CREATE TABLE Dim_Sala (
    ID_Sala INT PRIMARY KEY,
    Nome_Sala VARCHAR(50),
    Tipo_Sala VARCHAR(50),
    Capacidade INT
);

CREATE TABLE Fato_Sessao (
    ID_Sessao INT PRIMARY KEY,
    ID_Filme INT,
    ID_Sala INT,
    Data_Hora_Sessao DATETIME,
    Preco_Base DECIMAL(10, 2),
    FOREIGN KEY (ID_Filme) REFERENCES Dim_Filme(ID_Filme),
    FOREIGN KEY (ID_Sala) REFERENCES Dim_Sala(ID_Sala)
);

CREATE TABLE Fato_Venda_Ingresso (
    ID_Venda_Ingresso INT PRIMARY KEY,
    ID_Sessao INT,
    Tipo_Ingresso VARCHAR(30),
    Canal_Venda VARCHAR(50),
    Data_Venda DATETIME,
    Valor_Pago DECIMAL(10, 2),
    FOREIGN KEY (ID_Sessao) REFERENCES Fato_Sessao(ID_Sessao)
);

CREATE TABLE Fato_Venda_Bomboniere (
    ID_Venda_Bomboniere INT PRIMARY KEY,
    ID_Sessao INT,
    Item_Comprado VARCHAR(100),
    Quantidade INT,
    Valor_Total DECIMAL(10, 2),
    FOREIGN KEY (ID_Sessao) REFERENCES Fato_Sessao(ID_Sessao)
);

